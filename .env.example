# Copie este arquivo para backend/.env no SERVIDOR e preencha com valores de producao
# NUNCA commite o .env real (ja esta no .gitignore)

PORT=3000

# Gere novos segredos! Ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="TROQUE-PORE-UM-SEGREDO-FORTE"
JWT_REFRESH_SECRET="TROQUE-POR-OUTRO-SEGREDO-FORTE"

# URL publica do app (usada no CORS). Separe varias por virgula se precisar
FRONTEND_URL="http://SEU_IP_O_DOMINIO:3000"

# Caminho do build do frontend servido pelo backend (padrao ja correto se
# o repo for clonado em /var/www/financeapp)
# FRONTEND_DIST=/caminho/absoluto/frontend/dist

# Banco (SQLite por padrao; para PostgreSQL troque o provider no schema.prisma)
DATABASE_URL="file:./prod.db"

# Chave de acesso ao painel admin (troque a padrao!)
ADMIN_KEY="TROQUE-A-CHAVE-ADMIN"
