# Copie este arquivo para backend/.env no SERVIDOR e preencha com valores de producao
# NUNCA commite o .env real (ja esta no .gitignore)

PORT=3000

# Gere novos segredos (minimo 32 caracteres, OBRIGATORIOS em producao) e com
# valores DIFERENTES entre si. Ex:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="TROQUE-POR-UM-SEGREDO-FORTE-COM-32-CARACTERES"
JWT_REFRESH_SECRET="TROQUE-POR-OUTRO-SEGREDO-FORTE-DIFERENTE"

# Email do super administrador (OBRIGATORIO). O app recusa iniciar sem ele.
# A conta com este email deve existir no banco; rode `npm run bootstrap:super-admin`
# para promove-la a platform_admin.
SUPER_ADMIN_EMAIL="admin@seudominio.com"

# URL publica do app (usada no CORS). Separe varias por virgula se precisar
FRONTEND_URL="http://SEU_IP_O_DOMINIO:3000"

# Numero de proxies confiaveis à frente do app (ex.: 1 atras de Nginx/Hostinger).
# Deixe 0 se o app recebe conexoes diretas. Afeta o rate limit por IP.
TRUST_PROXY=1

# Caminho do build do frontend servido pelo backend (padrao ja correto se
# o repo for clonado em /var/www/financeapp)
# FRONTEND_DIST=/caminho/absoluto/frontend/dist

# Banco MySQL. O acesso remoto precisa estar liberado no painel do provedor
# (ex.: Hostinger: Databases -> Remote MySQL). Senha com caracteres especiais
# deve ser URL-encoding (; -> %3B, * -> %2A).
DATABASE_URL="mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO"
